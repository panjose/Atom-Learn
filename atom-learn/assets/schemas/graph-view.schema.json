{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/graph-view.schema.json",
  "title": "AtomLearn UI-agnostic graph view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "view_version", "activation_edge_kind", "focus", "focus_atom_id", "nodes", "edges",
    "filters", "revision", "course_revision"
  ],
  "properties": {
    "kind": {"const": "atomlearn.graph-view"},
    "view_version": {"const": "graph-view-v1"},
    "activation_edge_kind": {"const": "prerequisite"},
    "focus": {"type": "string", "minLength": 1, "maxLength": 200},
    "focus_atom_id": {"type": ["string", "null"], "maxLength": 200},
    "revision": {"type": "integer", "minimum": 0},
    "course_revision": {"type": "integer", "minimum": 0},
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional", "research"],
      "properties": {
        "required": {"type": "boolean"},
        "optional": {"type": "boolean"},
        "research": {"type": "boolean"}
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "status", "module", "optional", "focus"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 300},
          "kind": {"enum": ["atom", "paper"]},
          "label": {"type": "string", "minLength": 1, "maxLength": 1000},
          "status": {"type": "string", "minLength": 1, "maxLength": 100},
          "module": {"type": ["string", "null"], "maxLength": 500},
          "optional": {"type": "boolean"},
          "focus": {"type": "boolean"}
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "kind", "relation", "confidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^edge-[a-f0-9]{24}$"},
          "from": {"type": "string", "minLength": 1, "maxLength": 300},
          "to": {"type": "string", "minLength": 1, "maxLength": 300},
          "kind": {
            "enum": [
              "prerequisite", "containment", "scheduled-successor",
              "optional-branch", "citation", "semantic-related"
            ]
          },
          "relation": {"type": ["string", "null"], "maxLength": 200},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
