{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/panjose/Atom-Learn/schemas/exam-empirical-difficulty.schema.json",
  "title": "AtomLearn empirical exam difficulty aggregates",
  "type": "object", "additionalProperties": false, "required": ["aggregates"],
  "properties": {"aggregates": {"type": "array", "minItems": 1, "items": {
    "type": "object", "additionalProperties": false,
    "required": ["question_id", "attempt_count", "correct_rate", "median_seconds", "discrimination", "irt_b", "source", "source_locator"],
    "properties": {
      "question_id": {"type": "string"}, "attempt_count": {"type": "integer", "minimum": 0},
      "correct_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
      "median_seconds": {"type": ["number", "null"], "minimum": 0},
      "discrimination": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
      "irt_b": {"type": ["number", "null"], "minimum": -4, "maximum": 4},
      "source": {"type": "string", "minLength": 1}, "source_locator": {"type": "string", "minLength": 1}
    }, "anyOf": [{"properties": {"correct_rate": {"type": "number"}}}, {"properties": {"irt_b": {"type": "number"}}}]
  }}}
}
