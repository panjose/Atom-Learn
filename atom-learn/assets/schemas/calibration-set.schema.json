{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/calibration-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "id", "grader_id", "rubric_version", "thresholds", "items"],
  "properties": {
    "kind": {"const": "atomlearn.calibration-set"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "grader_id": {"type": "string", "minLength": 3},
    "rubric_version": {"type": "string", "minLength": 1},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_samples", "max_mae", "min_agreement", "max_abstain_rate", "agreement_tolerance"],
      "properties": {
        "min_samples": {"type": "integer", "minimum": 1},
        "max_mae": {"type": "number", "minimum": 0, "maximum": 1},
        "min_agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "max_abstain_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "agreement_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_sha256", "grader_id", "rubric_version", "calibration_set_version",
        "mae", "bias", "agreement", "abstain_rate", "review_required_rate",
        "max_allowed_metric_delta"
      ],
      "properties": {
        "report_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "grader_id": {"type": "string", "minLength": 3},
        "rubric_version": {"type": "string", "minLength": 1},
        "calibration_set_version": {"type": "string", "minLength": 3},
        "mae": {"type": "number", "minimum": 0, "maximum": 1},
        "bias": {"type": "number", "minimum": -1, "maximum": 1},
        "agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "abstain_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "review_required_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "max_allowed_metric_delta": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "strata", "human_scores", "prediction"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
          "strata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "domain", "difficulty", "answer_length"],
            "properties": {
              "language": {"type": "string", "minLength": 2},
              "domain": {"type": "string", "minLength": 2},
              "difficulty": {"enum": ["introductory", "intermediate", "advanced"]},
              "answer_length": {"enum": ["short", "medium", "long"]}
            }
          },
          "human_scores": {"$ref": "#/$defs/scores"},
          "prediction": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["abstain", "review_required"],
                "properties": {"abstain": {"const": true}, "review_required": {"const": true}}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["abstain", "review_required", "scores"],
                "properties": {
                  "abstain": {"const": false},
                  "review_required": {"type": "boolean"},
                  "scores": {"$ref": "#/$defs/scores"}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "scores": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{1,63}$"},
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
