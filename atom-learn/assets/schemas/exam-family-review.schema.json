{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/panjose/Atom-Learn/schemas/exam-family-review.schema.json",
  "title": "AtomLearn item-family review",
  "type": "object", "additionalProperties": false, "required": ["reviews"],
  "properties": {"reviews": {"type": "array", "minItems": 1, "items": {
    "type": "object", "additionalProperties": false, "required": ["family_id", "decision"],
    "properties": {
      "family_id": {"type": "string"}, "decision": {"enum": ["confirm", "correct", "reject"]},
      "canonical_id": {"type": ["string", "null"]}, "label": {"type": ["string", "null"]},
      "transfer_evidence": {"type": ["object", "null"], "properties": {
        "seen_attempts": {"type": "integer", "minimum": 0}, "seen_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "held_out_attempts": {"type": "integer", "minimum": 0}, "held_out_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "source_locator": {"type": "string", "minLength": 1}
      }}
    }
  }}}
}
