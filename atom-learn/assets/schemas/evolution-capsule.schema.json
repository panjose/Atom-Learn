{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/evolution-capsule.schema.json",
  "title": "AtomLearn privacy-minimized evolution capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "capsule_id", "core_version", "failure_type", "affected_feature", "window", "metrics", "candidate", "privacy"],
  "properties": {
    "kind": {"const": "atomlearn.evolution-capsule"},
    "schema_version": {"const": 1},
    "capsule_id": {"type": "string", "pattern": "^cap-[0-9a-f]{32}$"},
    "core_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "failure_type": {"enum": ["repeated_mastery_failure", "delayed_review_failure", "repeated_blocking_prerequisite", "strategy_underperformance", "retrieval_grounding_gap", "workflow_friction"]},
    "affected_feature": {"enum": ["teaching", "review", "concept_routing", "atomization", "rag", "research", "exam", "personalization", "migration", "update"]},
    "window": {"enum": ["sessions_2_to_4", "sessions_5_to_10", "sessions_11_to_25", "sessions_over_25"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence_bucket", "mastery_attempt_delta_bucket"],
      "properties": {
        "occurrence_bucket": {"enum": ["2", "3_to_5", "6_to_10", "over_10"]},
        "mastery_attempt_delta_bucket": {"enum": ["none", "under_1", "1_to_2", "over_2"]},
        "delayed_review_bucket": {"enum": ["not_observed", "improved", "unchanged", "worsened"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["teaching_policy", "review_policy", "routing_policy", "atomization_policy", "retrieval_policy", "workflow_policy", "migration_rule", "core_patch"]}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_messages_included", "source_content_included", "stable_user_id_included", "local_paths_included", "lint_status"],
      "properties": {
        "raw_messages_included": {"const": false},
        "source_content_included": {"const": false},
        "stable_user_id_included": {"const": false},
        "local_paths_included": {"const": false},
        "lint_status": {"const": "passed"}
      }
    }
  }
}
