{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/document-ir.schema.json",
  "title": "AtomLearn layout-preserving Document IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "source_id", "source_revision", "title", "uri",
    "extractor_version", "content_sha256", "created_at", "blocks"
  ],
  "properties": {
    "kind": {"const": "atomlearn.document-ir"},
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "source_revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 1000},
    "uri": {"type": "string", "minLength": 1, "maxLength": 4000},
    "extractor_version": {"const": "document-ir-v1"},
    "content_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id", "kind", "parent_id", "page", "bbox", "reading_order", "section",
        "locator", "extraction_method", "confidence", "text"
      ],
      "properties": {
        "block_id": {"type": "string", "pattern": "^block-[a-f0-9]{24}$"},
        "kind": {"enum": ["heading", "paragraph", "list", "table", "cell", "formula", "figure", "image", "ocr_text"]},
        "parent_id": {"type": ["string", "null"], "pattern": "^block-[a-f0-9]{24}$"},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "bbox": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "prefixItems": [
                {"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}
              ],
              "items": false
            }
          ]
        },
        "reading_order": {"type": "integer", "minimum": 1},
        "section": {"type": "string", "minLength": 1, "maxLength": 1000},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
        "extraction_method": {"enum": ["text", "structured", "pdf_text", "pdfplumber", "docx_xml", "html_dom", "ocr", "harness_vision"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "text": {"type": "string", "minLength": 1, "maxLength": 200000},
        "caption_block_id": {"type": ["string", "null"], "pattern": "^block-[a-f0-9]{24}$"},
        "crop_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "adjacent_block_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^block-[a-f0-9]{24}$"}
        },
        "review_status": {"enum": ["not_required", "proposed", "reviewed", "rejected"]},
        "numeric_status": {"enum": ["not_applicable", "unreviewed", "proposal", "verified", "rejected"]},
        "table_structure": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["row_count", "column_count", "header_rows", "rows"],
              "properties": {
                "row_count": {"type": "integer", "minimum": 1},
                "column_count": {"type": "integer", "minimum": 1},
                "header_rows": {"type": "integer", "minimum": 0},
                "rows": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["row_index", "cells"],
                    "properties": {
                      "row_index": {"type": "integer", "minimum": 1},
                      "cells": {
                        "type": "array", "items": {
                          "type": "object", "additionalProperties": false,
                          "required": ["column_index", "text", "row_span", "column_span", "is_header"],
                          "properties": {
                            "column_index": {"type": "integer", "minimum": 1},
                            "text": {"type": "string"},
                            "row_span": {"type": "integer", "minimum": 1},
                            "column_span": {"type": "integer", "minimum": 1},
                            "is_header": {"type": "boolean"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
