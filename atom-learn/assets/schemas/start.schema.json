{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/panjose/Atom-Learn/blob/main/atom-learn/assets/schemas/start.schema.json",
  "title": "AtomLearn unified start payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "course_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 1000},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "request_summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "mode": {"enum": ["sources", "outline", "topic"]},
    "desired_outcome": {"enum": ["orientation", "working_knowledge", "exam", "project", "research"]},
    "target_depth": {"enum": ["overview", "working", "advanced", "expert"]},
    "prior_knowledge": {"$ref": "#/$defs/stringList"},
    "constraints": {"$ref": "#/$defs/stringList"},
    "ambiguities": {"$ref": "#/$defs/stringList"},
    "assumptions": {"$ref": "#/$defs/stringList"},
    "mandatory_anchors": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1, "maxLength": 4000},
          {"$ref": "#/$defs/mandatoryAnchor"}
        ]
      }
    },
    "corpus_policy": {"$ref": "#/$defs/corpusPolicy"},
    "topic": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/stringList"}]},
    "topic_terms": {"$ref": "#/$defs/stringList"},
    "outline_source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "outline_title": {"type": "string", "minLength": 1},
    "outline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
              "title": {"type": "string", "minLength": 1},
              "parent_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9.-]*$"},
              "notes": {"type": "string"}
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/source"}
    },
    "web_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources"],
      "properties": {"sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/webSource"}}}
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "evidence_chunk_ids", "rationale"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "status": {"enum": ["supported", "weak", "missing"]},
          "evidence_chunk_ids": {"$ref": "#/$defs/stringList"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "course_plan": {"type": "object"},
    "confirmed": {"type": "boolean"},
    "activate_first": {"type": "boolean"},
    "chunk_chars": {"type": "integer", "minimum": 400, "maximum": 12000},
    "overlap_chars": {"type": "integer", "minimum": 0, "maximum": 2000}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "corpusPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "expansion", "user_confirmed"],
      "properties": {
        "role": {"enum": ["full", "partial", "supplemental", "outline_like", "unknown"]},
        "expansion": {"enum": ["closed_corpus", "correct_gaps", "discover"]},
        "user_confirmed": {"type": "boolean"}
      }
    },
    "mandatoryAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "query": {"type": "string", "minLength": 1, "maxLength": 4000},
        "minimum_sources": {"type": "integer", "minimum": 1, "maximum": 10},
        "authoritative": {"type": "boolean"}
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "locator": {"type": "string"},
        "section": {"type": "string"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "title": {"type": "string", "minLength": 1},
        "type": {"enum": ["pdf", "book", "notes", "documentation", "website", "database", "outline", "exam", "other"]},
        "authority": {"enum": ["primary", "official", "peer_reviewed", "textbook", "user", "secondary", "unknown"]},
        "version": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "text": {"type": "string", "minLength": 1},
        "passages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/passage"}},
        "ocr": {"enum": ["auto", "required", "off"]},
        "ocr_language": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["path"]}, {"required": ["text"]}, {"required": ["passages"]}]
    },
    "webSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "retrieved_at", "query", "authority", "passages"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "query": {"type": "string", "minLength": 1},
        "authority": {"enum": ["primary", "official", "peer_reviewed", "textbook", "secondary", "unknown"]},
        "version": {"type": "string"},
        "passages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/passage"}}
      }
    }
  }
}
