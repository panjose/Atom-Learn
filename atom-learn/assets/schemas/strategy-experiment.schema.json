{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/strategy-experiment.schema.json",
  "title": "AtomLearn strategy experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "revision",
    "id",
    "scope",
    "dimension",
    "baseline",
    "candidate",
    "hypothesis",
    "evidence_refs",
    "contexts",
    "status",
    "shadow_mode",
    "strata",
    "metrics",
    "minimums",
    "thresholds",
    "eligibility",
    "analysis"
  ],
  "properties": {
    "kind": {"const": "atomlearn.strategy-experiment"},
    "schema_version": {"const": 2},
    "revision": {"type": "integer", "minimum": 0},
    "id": {"type": "string", "pattern": "^exp-[A-Za-z0-9._-]{1,96}$"},
    "scope": {"enum": ["course", "user"]},
    "dimension": {"enum": ["explanation.order", "example.mode", "teaching.mode", "feedback.style", "check.style", "review.presentation"]},
    "baseline": {"type": "string", "minLength": 1, "maxLength": 64},
    "candidate": {"type": "string", "minLength": 1, "maxLength": 64},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 500},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:ev|evt|rv)-[A-Za-z0-9._:-]{1,96}$"}
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["orientation", "teaching", "review", "exam"]}
    },
    "status": {"enum": ["candidate", "eligible", "monitoring", "active", "paused", "rejected", "retired", "needs_review"]},
    "shadow_mode": {"type": "boolean"},
    "strata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_types", "episode_types"],
      "properties": {
        "atom_types": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 32}, "uniqueItems": true},
        "episode_types": {"type": "array", "items": {"enum": ["new_learning", "remediation", "review"]}, "uniqueItems": true}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_learning", "learning", "process", "ux", "guardrails"],
      "properties": {
        "primary_learning": {"$ref": "#/$defs/learningMetrics"},
        "learning": {"$ref": "#/$defs/learningMetrics"},
        "process": {"type": "array", "uniqueItems": true, "items": {"enum": ["mastery_attempts", "blocking_backtrack_rate"]}},
        "ux": {"type": "array", "uniqueItems": true, "items": {"enum": ["override_rate"]}},
        "guardrails": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["misconception_recurrence", "mastery_failure_rate"]}}
      }
    },
    "minimums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomes_per_arm", "distinct_episodes", "delayed_outcomes_per_arm"],
      "properties": {
        "outcomes_per_arm": {"type": "integer", "minimum": 10},
        "distinct_episodes": {"type": "integer", "minimum": 20},
        "delayed_outcomes_per_arm": {"type": "integer", "minimum": 5}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_learning_effect", "maximum_learning_degradation", "maximum_guardrail_delta"],
      "properties": {
        "minimum_learning_effect": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "maximum_learning_degradation": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_guardrail_delta": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_kinds", "quality_tiers", "grader_ids"],
      "properties": {
        "measurement_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["immediate_mastery", "delayed_retention", "near_transfer", "far_transfer"]}},
        "quality_tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["A", "B"]}},
        "grader_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 128}}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "method", "seed", "bootstrap_resamples", "confidence_level",
        "max_outcomes_per_arm", "stop_for_harm", "stop_at_max_without_effect"
      ],
      "properties": {
        "version": {"const": "strategy-bootstrap-v1"},
        "method": {"const": "stratified_bootstrap"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "bootstrap_resamples": {"type": "integer", "minimum": 500, "maximum": 10000},
        "confidence_level": {"enum": [0.9, 0.95, 0.99]},
        "max_outcomes_per_arm": {"type": "integer", "minimum": 10, "maximum": 10000},
        "stop_for_harm": {"const": true},
        "stop_at_max_without_effect": {"const": true}
      }
    }
  },
  "$defs": {
    "learningMetrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["immediate_mastery_score", "delayed_retention_score", "near_transfer_score", "far_transfer_score"]}
    }
  }
}
