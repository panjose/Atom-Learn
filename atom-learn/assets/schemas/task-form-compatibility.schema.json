{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/task-form-compatibility.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "matrix_version", "task_forms"],
  "properties": {
    "kind": {"const": "atomlearn.task-form-compatibility"},
    "schema_version": {"const": 1},
    "matrix_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "task_forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "response_modes", "supported_dimensions", "constraints"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "response_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}},
          "supported_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}},
          "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
        }
      }
    }
  }
}
