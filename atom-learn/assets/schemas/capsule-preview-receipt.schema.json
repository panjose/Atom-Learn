{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/capsule-preview-receipt.schema.json",
  "title": "AtomLearn local capsule preview receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "capsule_id", "capsule_hash", "previewed_at"],
  "properties": {
    "kind": {"const": "atomlearn.capsule-preview-receipt"},
    "schema_version": {"const": 1},
    "capsule_id": {"type": "string", "pattern": "^cap-[0-9a-f]{32}$"},
    "capsule_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "previewed_at": {"type": "string", "format": "date-time"}
  }
}
