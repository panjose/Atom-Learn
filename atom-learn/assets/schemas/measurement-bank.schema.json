{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/measurement-bank.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "bank_id", "bank_version", "items"],
  "properties": {
    "kind": {"const": "atomlearn.measurement-bank"},
    "schema_version": {"const": 1},
    "bank_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"},
    "bank_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "atom_family_id", "measurement_kind", "required_dimensions", "prompt",
        "grader_id", "rubric_version", "answer_spec", "holdout", "retention_delay_days",
        "language", "domain", "difficulty"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
        "atom_family_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
        "measurement_kind": {"enum": ["immediate_mastery", "delayed_retention", "near_transfer", "far_transfer"]},
        "required_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 10000},
        "grader_id": {"type": "string", "minLength": 3},
        "rubric_version": {"type": "string", "minLength": 1},
        "answer_spec": {
          "type": "object",
          "additionalProperties": true,
          "required": ["type"],
          "properties": {"type": {"enum": ["exact_choice", "numeric_unit", "open_response"]}}
        },
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visibility", "context_isolated", "family_id"],
          "properties": {
            "visibility": {"enum": ["teaching_visible", "held_out"]},
            "context_isolated": {"type": "boolean"},
            "family_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"}
          }
        },
        "retention_delay_days": {"type": ["integer", "null"], "minimum": 1},
        "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
        "domain": {"type": "string", "minLength": 2, "maxLength": 100},
        "difficulty": {"enum": ["introductory", "intermediate", "advanced"]}
      }
    }
  }
}
