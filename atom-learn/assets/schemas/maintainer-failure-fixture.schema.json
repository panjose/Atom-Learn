{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/maintainer-failure-fixture.schema.json",
  "title": "AtomLearn maintainer reproduction-fixture seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "source_fingerprint", "core_version", "failure_type", "affected_feature", "candidate_type", "metrics", "status", "requires_reproduction_test", "automatic_patch_allowed"],
  "properties": {
    "kind": {"const": "atomlearn.maintainer-failure-fixture"},
    "schema_version": {"const": 1},
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "core_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "failure_type": {"enum": ["repeated_mastery_failure", "delayed_review_failure", "repeated_blocking_prerequisite", "strategy_underperformance", "retrieval_grounding_gap", "workflow_friction"]},
    "affected_feature": {"enum": ["teaching", "review", "concept_routing", "atomization", "rag", "research", "exam", "personalization", "migration", "update"]},
    "candidate_type": {"enum": ["teaching_policy", "review_policy", "routing_policy", "atomization_policy", "retrieval_policy", "workflow_policy", "migration_rule", "core_patch"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence_bucket", "mastery_attempt_delta_bucket"],
      "properties": {
        "occurrence_bucket": {"enum": ["2", "3_to_5", "6_to_10", "over_10"]},
        "mastery_attempt_delta_bucket": {"enum": ["none", "under_1", "1_to_2", "over_2"]},
        "delayed_review_bucket": {"enum": ["not_observed", "improved", "unchanged", "worsened"]}
      }
    },
    "status": {"const": "needs_reproduction"},
    "requires_reproduction_test": {"const": true},
    "automatic_patch_allowed": {"const": false}
  }
}
