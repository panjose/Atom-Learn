{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/learning-study.schema.json",
  "title": "AtomLearn privacy-safe learning-effect study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "revision", "study_id", "status", "consent",
    "design", "privacy", "created_at", "updated_at"
  ],
  "properties": {
    "kind": {"const": "atomlearn.learning-study"},
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "study_id": {"type": "string", "pattern": "^study-[A-Za-z0-9._-]{1,80}$"},
    "status": {"enum": ["enrolled", "withdrawn", "closed"]},
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit", "consent_version", "granted_at", "withdrawable", "data_categories"],
      "properties": {
        "explicit": {"const": true},
        "consent_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "granted_at": {"type": "string", "format": "date-time"},
        "withdrawable": {"const": true},
        "data_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["assessment_scores", "process_counts", "timing_buckets", "ux_ratings"]}
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_condition", "candidate_condition", "assignment_method", "measures",
        "strata", "missing_data_policy", "analysis_version"
      ],
      "properties": {
        "control_condition": {"type": "string", "minLength": 1, "maxLength": 120},
        "candidate_condition": {"type": "string", "minLength": 1, "maxLength": 120},
        "assignment_method": {"enum": ["randomized", "matched", "quasi_experimental"]},
        "measures": {
          "type": "array",
          "uniqueItems": true,
          "allOf": [
            {"contains": {"const": "immediate_mastery"}},
            {"contains": {"const": "delayed_retention_7d"}},
            {"contains": {"const": "delayed_retention_30d"}},
            {"contains": {"const": "near_transfer"}},
            {"contains": {"const": "far_transfer"}}
          ],
          "items": {"enum": [
            "immediate_mastery", "delayed_retention_7d", "delayed_retention_30d",
            "near_transfer", "far_transfer", "completion", "withdrawal", "total_time", "prompt_burden"
          ]}
        },
        "strata": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "allOf": [
            {"contains": {"const": "domain"}},
            {"contains": {"const": "prior_knowledge"}}
          ],
          "items": {"enum": ["domain", "prior_knowledge", "language"]}
        },
        "missing_data_policy": {"enum": ["intention_to_treat", "available_case_with_sensitivity"]},
        "analysis_version": {"const": "learning-effect-study-v1"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_answers", "content_text", "opaque_refs_only", "local_only", "automatic_export"],
      "properties": {
        "raw_answers": {"const": false},
        "content_text": {"const": false},
        "opaque_refs_only": {"const": true},
        "local_only": {"const": true},
        "automatic_export": {"const": false}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "withdrawn_at": {"type": "string", "format": "date-time"}
  }
}
