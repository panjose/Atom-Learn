{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/workflow-submission.schema.json",
  "title": "AtomLearn typed harness workflow submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "action_id", "workflow_revision", "idempotency_key", "result"
  ],
  "properties": {
    "kind": {"const": "atomlearn.workflow-submission"},
    "schema_version": {"const": 1},
    "action_id": {"type": "string", "pattern": "^action-[a-f0-9]{24}$"},
    "workflow_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "result": {"type": "object"}
  }
}
