{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/exam-official-difficulty.schema.json",
  "title": "AtomLearn reviewed source-located official exam difficulty",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "level", "source", "source_locator", "reviewer_id"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "level": {"type": "number", "minimum": 1, "maximum": 5},
          "source": {"type": "string", "minLength": 1, "maxLength": 300},
          "source_locator": {"type": "string", "minLength": 1, "maxLength": 1000},
          "reviewer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"}
        }
      }
    }
  }
}
