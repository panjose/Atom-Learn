{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomlearn.dev/schemas/release-manifest-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "manifest_version", "version", "channel", "tag", "source", "artifact",
    "manager_artifact", "core_manifest_sha256", "core_content_sha256", "gate_report_sha256",
    "min_manager_version", "schemas", "skill_protocol", "runtime_bundles", "capabilities",
    "smoke_fixture_sha256", "trust", "signature"
  ],
  "properties": {
    "kind": {"const": "atomlearn.release-manifest"},
    "manifest_version": {"const": 2},
    "version": {"$ref": "#/$defs/version"},
    "channel": {"enum": ["prerelease", "stable"]},
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "commit_sha", "artifact_url"],
      "properties": {
        "kind": {"const": "github_release"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"}
      }
    },
    "artifact": {"$ref": "#/$defs/asset"},
    "manager_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "filename", "format", "sha256", "size"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "filename": {"type": "string", "pattern": "^atomlearn_manager-[0-9A-Za-z.+-]+-py3-none-any\\.whl$"},
        "format": {"const": "wheel"},
        "sha256": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "core_manifest_sha256": {"$ref": "#/$defs/hash"},
    "core_content_sha256": {"$ref": "#/$defs/hash"},
    "gate_report_sha256": {"$ref": "#/$defs/hash"},
    "min_manager_version": {"$ref": "#/$defs/version"},
    "schemas": {"$ref": "#/$defs/schemas"},
    "skill_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "entrypoint", "entrypoint_sha256", "bridge_min", "bridge_max"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "entrypoint": {"const": "atom-learn/SKILL.md"},
        "entrypoint_sha256": {"$ref": "#/$defs/hash"},
        "bridge_min": {"type": "integer", "minimum": 1},
        "bridge_max": {"type": "integer", "minimum": 1}
      }
    },
    "runtime_bundles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/runtime"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_sha256", "required_smoke"],
      "properties": {
        "ledger_sha256": {"$ref": "#/$defs/hash"},
        "required_smoke": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["core", "bridge", "documents", "rag", "exam", "research", "review"]}
        },
        "runtime_profiles_sha256": {"$ref": "#/$defs/hash"},
        "stable_runtime_profiles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["base", "scale", "semantic-cpu", "ocr"]}
        }
      }
    },
    "smoke_fixture_sha256": {"$ref": "#/$defs/hash"},
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_version", "key_id"],
      "properties": {
        "bundle_version": {"type": "integer", "minimum": 1},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "format", "sha256", "size"],
      "properties": {
        "filename": {"type": "string", "pattern": "^atomlearn-[0-9A-Za-z.+-]+\\.zip$"},
        "format": {"const": "zip"},
        "sha256": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size"],
      "properties": {
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+\\.whl$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "platform", "architecture", "python_minor", "filename", "url",
        "sha256", "size", "recipe_sha256", "core_wheel"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9._-]{3,128}$"},
        "core_version": {"$ref": "#/$defs/version"},
        "platform": {"enum": ["linux", "windows"]},
        "architecture": {"enum": ["amd64", "arm64"]},
        "python_minor": {"type": "string", "pattern": "^3\\.(10|11|12|13)$"},
        "filename": {"type": "string", "pattern": "^atomlearn-runtime-[a-z0-9._-]+\\.zip$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "sha256": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 1},
        "recipe_sha256": {"$ref": "#/$defs/hash"},
        "core_wheel": {"$ref": "#/$defs/wheel"},
        "profile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/profile"}]},
        "profile_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "dependency_lock_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "model_lock": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/model_lock"}]},
        "smoke_report_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "smoke": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/profile_smoke"}]}
      },
      "allOf": [
        {
          "if": {"required": ["profile"]},
          "then": {
            "required": [
              "core_version", "profile_hash", "dependency_lock_sha256", "model_lock",
              "smoke_report_sha256", "smoke"
            ]
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "capabilities", "stability", "python_modules", "native_requirements",
        "model_policy", "smoke_suites"
      ],
      "properties": {
        "name": {"enum": ["base", "scale", "semantic-cpu", "ocr", "semantic-gpu"]},
        "capabilities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["base", "scale", "semantic-cpu", "ocr", "semantic-gpu"]}
        },
        "stability": {"enum": ["stable", "experimental"]},
        "python_modules": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"}
        },
        "native_requirements": {
          "type": "array", "items": {"$ref": "#/$defs/native_requirement"}
        },
        "model_policy": {"$ref": "#/$defs/model_policy"},
        "smoke_suites": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["base", "scale-index", "semantic-retrieval", "ocr-layout", "semantic-gpu"]}
        }
      }
    },
    "native_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "version_args"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
        "command": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "version_args": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "silent_download"],
      "properties": {
        "mode": {"enum": ["none", "pinned_local"]},
        "silent_download": {"const": false},
        "trust_remote_code": {"const": false},
        "allowed_weight_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "model_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "trust_remote_code", "files"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "trust_remote_code": {"const": false},
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": {"type": "string", "pattern": "^[A-Za-z0-9_.\\/-]+$"},
              "sha256": {"$ref": "#/$defs/hash"},
              "size": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "profile_smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "profile", "status", "suites", "platform_verified"],
      "properties": {
        "kind": {"const": "atomlearn.runtime-profile-smoke"},
        "schema_version": {"const": 1},
        "profile": {"enum": ["base", "scale", "semantic-cpu", "ocr", "semantic-gpu"]},
        "status": {"enum": ["pending", "passed", "failed"]},
        "suites": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["base", "scale-index", "semantic-retrieval", "ocr-layout", "semantic-gpu"]}
        },
        "platform_verified": {"type": "boolean"},
        "platform": {"enum": ["linux", "windows"]},
        "architecture": {"enum": ["amd64", "arm64"]},
        "python_minor": {"type": "string", "pattern": "^3\\.(10|11|12|13)$"},
        "report_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "passed"}}},
          "then": {"required": ["platform", "architecture", "python_minor"]}
        }
      ]
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{1,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["read", "write"],
        "properties": {
          "read": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
          "write": {"type": "integer", "minimum": 1}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
      }
    }
  }
}
