{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "revision", "bundle_version", "trust_level", "repositories", "keys"],
  "properties": {
    "kind": {"const": "atomlearn.manager-trust"},
    "schema_version": {"const": 2},
    "revision": {"type": "integer", "minimum": 1},
    "bundle_version": {"type": "integer", "minimum": 1},
    "trust_level": {"enum": ["pinned", "verified_tofu", "unverified"]},
    "repositories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}},
    "keys": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9._-]{1,64}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "public_key", "fingerprint", "status"],
        "properties": {
          "algorithm": {"const": "ed25519"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["active", "retiring", "revoked"]}
        }
      }
    }
  }
}
