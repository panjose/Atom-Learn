{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "id", "status", "stage", "codex_home", "target_path",
    "backup_path", "failed_bridge_path", "source_sha256", "source_versions",
    "created_at", "updated_at", "error"
  ],
  "properties": {
    "kind": {"const": "atomlearn.bridge-migration"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^bmtxn-[0-9a-f]{32}$"},
    "status": {"enum": ["in_progress", "committed", "failed", "recovered", "needs_manual_recovery"]},
    "stage": {"enum": ["planned", "backed_up", "bridge_installed", "verified", "committed", "recovered"]},
    "codex_home": {"type": "string", "minLength": 1},
    "target_path": {"type": "string", "minLength": 1},
    "backup_path": {"type": "string", "minLength": 1},
    "failed_bridge_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "error": {"type": ["string", "null"]}
  }
}
