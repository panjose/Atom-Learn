{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "manifest_version", "skill_name", "core_version", "skill_protocol_version", "capability_ledger", "smoke_fixtures", "release_channel", "feature_defaults", "schemas", "artifact_sha256"],
  "properties": {
    "kind": {"const": "atomlearn.core-manifest"},
    "manifest_version": {"const": 1},
    "skill_name": {"const": "atom-learn"},
    "core_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "skill_protocol_version": {"const": 1},
    "capability_ledger": {"const": "atom-learn/assets/capabilities.yaml"},
    "smoke_fixtures": {"const": "atom-learn/assets/smoke-fixtures.json"},
    "runtime_profiles": {"const": "atom-learn/assets/runtime-profiles.yaml"},
    "release_channel": {"enum": ["development", "prerelease", "stable"]},
    "feature_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_personalization", "strategy_experiments", "capsule_export", "release_manager"],
      "properties": {
        "global_personalization": {"const": false},
        "strategy_experiments": {"const": false},
        "capsule_export": {"const": false},
        "release_manager": {"const": false}
      }
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{1,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["read", "write"],
        "properties": {
          "read": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
          "write": {"type": "integer", "minimum": 1}
        }
      }
    },
    "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
