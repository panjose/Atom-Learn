{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "revision", "repositories", "keys"],
  "properties": {
    "kind": {"const": "atomlearn.manager-trust"},
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "repositories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}},
    "keys": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9._-]{1,64}$"},
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
    }
  }
}
