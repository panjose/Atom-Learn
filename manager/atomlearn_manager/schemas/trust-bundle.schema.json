{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "bundle_version", "previous_bundle_version", "repository", "keys"],
  "properties": {
    "kind": {"const": "atomlearn.trust-bundle"},
    "schema_version": {"const": 1},
    "bundle_version": {"type": "integer", "minimum": 1},
    "previous_bundle_version": {"type": ["integer", "null"], "minimum": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key", "fingerprint", "status"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
          "algorithm": {"const": "ed25519"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["active", "retiring", "revoked"]}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
      }
    }
  }
}
